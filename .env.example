# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
# LOG_LEVEL=debug

# MySQL (docker compose up -d starts one on 3306)
DATABASE_URL=mysql://alertly:alertly@127.0.0.1:3306/alertly
DB_POOL_SIZE=10
# Used by integration tests to create throwaway databases (needs CREATE/DROP privileges)
TEST_DATABASE_URL=mysql://root:root@127.0.0.1:3306

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (JWT_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (ENCRYPTION_KEY)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZSE=

# The dashboard's origin (CORS + cookies)
WEB_ORIGIN=http://localhost:3000

# Email: set RESEND_API_KEY for real delivery, or SMTP_URL (Mailpit locally: http://localhost:8025)
EMAIL_FROM=Alertly <alerts@alertly.local>
SMTP_URL=smtp://127.0.0.1:1025
# RESEND_API_KEY=

# Telegram: create a bot with @BotFather and paste its token
# TELEGRAM_BOT_TOKEN=

PRICE_PROVIDER_DEFAULT=simulated
WORKER_CONCURRENCY=5
WORKER_BATCH_SIZE=20
SCHEDULER_INTERVAL_SEC=15
DAILY_NOTIFICATION_QUOTA=1000
API_RATE_LIMIT_PER_MIN=60

# Allow webhooks to localhost/private IPs (local testing only; refused in production)
WEBHOOK_ALLOW_PRIVATE=true

# Web app (Next.js): where its /api/* rewrite forwards to
API_URL=http://localhost:4000
